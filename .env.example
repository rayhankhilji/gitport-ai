# Required: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Model selection (defaults are current Cohere production models)
GITPORT_CHAT_MODEL=command-a-plus-05-2026
GITPORT_EMBED_MODEL=embed-v4.0
GITPORT_RERANK_MODEL=rerank-v3.5

# Where the rules index lives and which docs to index
GITPORT_INDEX_PATH=.gitport/index.sqlite3
GITPORT_RULES_DIR=docs/rules

# Retrieval + agent tuning
GITPORT_TOP_K_RULES=3
GITPORT_AGENT_MAX_STEPS=8
GITPORT_MAX_DIFF_CHARS=60000

# Policy-as-code + audit
GITPORT_POLICY_PATH=.gitport/policy.toml
GITPORT_REPORTS_DB=.gitport/reports.sqlite3
GITPORT_STORE_REPORTS=1

# REST API hardening
GITPORT_API_TOKEN=            # bearer auth for /v1/* (empty = local only)
GITPORT_RATE_LIMIT_RPM=120    # per-client; 0 disables
GITPORT_MAX_REQUEST_BYTES=5000000
GITPORT_CORS_ORIGINS=         # comma-separated, empty = same-origin only
GITPORT_LOG_FORMAT=text       # text | json

# Set to 1 to downgrade engine errors to warnings instead of failing closed
GITPORT_FAIL_OPEN=0

# GitHub integration (for --post-comment / --set-status)
GITHUB_TOKEN=
